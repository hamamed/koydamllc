# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Admin auth ----
# Long random string used to sign the admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Admin login ----
# Set ONE of the two below. If both are set, the hash wins.
ADMIN_EMAIL=hello@koydam.com

# Simple: the password in plain text. Anyone who can read this
# configuration can also read the password.
ADMIN_PASSWORD=changeme

# Safer: a one-way hash, so the real password is stored nowhere.
# Generate with: node server/scripts/hash-password.js "your password"
ADMIN_PASSWORD_HASH=

# Session lifetime in hours
SESSION_HOURS=12

# ---- Contact form email (optional) ----
# Leave SMTP_HOST empty to just store inquiries in the DB without emailing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_TO=hello@koydam.com
MAIL_FROM="Koydam Website <no-reply@koydam.com>"

# ---- Data storage ----
# Keep live content and uploads OUTSIDE the deploy directory, so a deployment
# cannot delete them. Leave unset to use server/data and public/uploads.
KOYDAM_DATA_DIR=
KOYDAM_UPLOAD_DIR=

# Public base URL, used in sitemap.xml
SITE_URL=https://koydam.com
